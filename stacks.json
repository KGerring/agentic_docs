<!DOCTYPE html><html  lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>How we curate · StackMap</title><script type="importmap">{"imports":{"#entry":"/_nuxt/Cyczvyij.js"}}</script><link rel="stylesheet" href="/_nuxt/entry.U26w-V11.css" crossorigin><link rel="preload" as="fetch" crossorigin="anonymous" href="/how-we-curate/_payload.json?_b=0e7a65bd-2b4f-4132-8bd4-fa88e371888b"><link rel="modulepreload" as="script" crossorigin href="/_nuxt/Cyczvyij.js"><link rel="modulepreload" as="script" crossorigin href="/_nuxt/CGfFMP5b.js"><link rel="modulepreload" as="script" crossorigin href="/_nuxt/BtA5mdwM.js"><link rel="modulepreload" as="script" crossorigin href="/_nuxt/FtAJy03d.js"><link rel="modulepreload" as="script" crossorigin href="/_nuxt/DFNFr32X.js"><link rel="modulepreload" as="script" crossorigin href="/_nuxt/Dw3pEhNK.js"><link rel="modulepreload" as="script" crossorigin href="/_nuxt/HclGiUj8.js"><link rel="modulepreload" as="script" crossorigin href="/_nuxt/Bp7378c7.js"><link rel="modulepreload" as="script" crossorigin href="/_nuxt/CoYNax-F.js"><link rel="modulepreload" as="script" crossorigin href="/_nuxt/C0rS5Qat.js"><link rel="modulepreload" as="script" crossorigin href="/_nuxt/Djs-fPcF.js"><link rel="modulepreload" as="script" crossorigin href="/_nuxt/BDNMzG2s.js"><link rel="modulepreload" as="script" crossorigin href="/_nuxt/7ep7tFnW2.js"><link rel="modulepreload" as="script" crossorigin href="/_nuxt/hT7iILKC2.js"><script type="module" src="/_nuxt/Cyczvyij.js" crossorigin></script><link rel="prefetch" as="script" crossorigin href="/_nuxt/q3AaC0m_.js"><link rel="prefetch" as="script" crossorigin href="/_nuxt/B585pSn2.js"><meta name="description" content="Every StackMap connection is a typed, human-reviewed relationship with the why written down. No auto-publish: proposals are drafted, then a human approves — or refuses."><meta property="og:title" content="How we curate · StackMap"><meta property="og:description" content="Every StackMap connection is a typed, human-reviewed relationship with the why written down. No auto-publish: proposals are drafted, then a human approves — or refuses."><meta property="og:image" content="https://stackmap.shipwithai.xyz/og.png"><meta property="og:type" content="website"><meta property="og:site_name" content="StackMap"><meta name="twitter:card" content="summary_large_image"><meta name="twitter:image" content="https://stackmap.shipwithai.xyz/og.png"><link rel="icon" type="image/svg+xml" href="/logo/stackmap-favicon-on-dark.svg"><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630"><meta property="og:url" content="https://stackmap.shipwithai.xyz/how-we-curate"><link rel="canonical" href="https://stackmap.shipwithai.xyz/how-we-curate"><script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How is StackMap different from an awesome-list?","acceptedAnswer":{"@type":"Answer","text":"Lists tell you what exists. StackMap maps typed relationships — complements, alternative, built_with — and every connection carries a human-written \"why\", including when NOT to use a tool."}},{"@type":"Question","name":"Does anything publish automatically?","acceptedAnswer":{"@type":"Answer","text":"No. Every repo and every edge goes through a proposal that a human approves, sharpens, or refuses. Stars and activity data refresh automatically twice a week; judgments never do."}}]}</script><script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Explore","item":"https://stackmap.shipwithai.xyz/"},{"@type":"ListItem","position":2,"name":"How we curate"}]}</script></head><body><div id="__nuxt"><div><header class="z-30 flex flex-wrap items-center gap-x-5 gap-y-0 px-6 py-3 backdrop-blur sm:sticky sm:top-0 sm:flex-nowrap" style="background:rgba(10,11,15,.78);border-bottom:1px solid var(--line);"><a href="/" class="flex items-center gap-2"><svg class="h-5 w-5" viewBox="0 0 96 96" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><line x1="76" y1="30" x2="76" y2="66" stroke="#8b8fa3" stroke-width="3"></line><polygon points="48,17 76,30 48,43 20,30" fill="#f5791e"></polygon><path d="M20,50 L48,63 L76,50" fill="none" stroke="#8b8fa3" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M20,66 L48,79 L76,66" fill="none" stroke="#8b8fa3" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"></path><circle cx="76" cy="30" r="6.4" fill="#f5791e"></circle><circle cx="76" cy="50" r="5.2" fill="#f5791e"></circle><circle cx="76" cy="66" r="5.2" fill="#f5791e"></circle></svg><span class="font-extrabold tracking-tight">Stack<span style="color:var(--org);">Map</span></span><span class="mono hidden text-[.66rem] uppercase tracking-[.18em] sm:inline" style="color:var(--mut);">by ShipWithAI</span></a><nav class="order-last -mx-6 flex w-[calc(100%+3rem)] gap-1 overflow-x-auto px-6 text-sm sm:order-none sm:mx-0 sm:ml-2 sm:w-auto sm:overflow-visible" style="color:var(--mut);scrollbar-width:none;" aria-label="Site"><a href="/" class="shrink-0 rounded px-2 py-3 hover:text-white sm:py-1">Explore</a><a href="/paths" class="shrink-0 rounded px-2 py-3 hover:text-white sm:py-1">Paths</a><a href="/changelog" class="shrink-0 rounded px-2 py-3 hover:text-white sm:py-1">Changelog</a><a aria-current="page" href="/how-we-curate" class="router-link-active router-link-exact-active shrink-0 rounded px-2 py-3 hover:text-white sm:py-1">How we curate</a><a href="/about" class="shrink-0 rounded px-2 py-3 hover:text-white sm:py-1">About</a><a href="/mcp" class="shrink-0 rounded px-2 py-3 hover:text-white sm:py-1">MCP</a><a href="/stacks" class="shrink-0 rounded px-2 py-3 hover:text-white sm:py-1">My Stack</a></nav><div class="flex-1"></div><a href="/changelog" class="mono hidden shrink-0 rounded-full px-2.5 py-1 text-[.66rem] hover:text-white md:inline" title="What changed — the map updates daily" style="border:1px solid var(--line);color:var(--mut);"> v2026.10.08</a><a href="https://stackmap.substack.com/subscribe" target="_blank" rel="noopener" class="btn shrink-0 px-3 py-1.5 text-sm"> Subscribe </a></header><main class="mx-auto max-w-3xl px-6 py-10"><h1 class="text-3xl font-extrabold tracking-tight">How we curate</h1><p class="mt-3 text-lg" style="color:var(--txt2);"> Lists tell you <em>what exists</em>. StackMap tells you <b>what goes together — and why</b>. </p><div class="mono mt-6 flex flex-wrap gap-6 text-sm" style="color:var(--mut);"><span><b style="color:var(--org);">421</b> repos</span><span><b style="color:var(--org);">23</b> topics</span><span><b style="color:var(--org);">1141</b> typed connections — every one human-reviewed</span></div><h2 class="mt-10 text-xl font-bold tracking-tight">Typed relationships, not links</h2><p class="mt-2" style="color:var(--txt2);">Every connection in the catalog is one of three kinds:</p><ul class="mt-3 flex flex-col gap-2" style="color:var(--txt2);"><li><b style="color:#f5791e;">complements</b> — use them together; one covers what the other doesn&#39;t.</li><li><b style="color:#8a96b4;">alternative</b> — different project, same job; we say when to pick which.</li><li><b style="color:#46c89c;">built_with</b> — depends on, builds on, or runs on.</li></ul><p class="mt-3" style="color:var(--txt2);"> And every connection carries a written <b>&quot;why&quot;</b> — the sentence a colleague would tell you over your shoulder. This is what a why looks like: </p><div class="card mt-4 p-4"><div class="mono mb-1 text-sm" style="color:var(--mut);">LangGraph <span style="color:#f5791e;">→ pairs well with</span> LangSmith</div><div class="why"><span class="lab">Why it fits</span>Once your graph runs in production you&#39;ll want to see why a run failed — LangSmith traces every node.</div></div><h2 class="mt-10 text-xl font-bold tracking-tight">Nothing publishes without a human</h2><ol class="mt-3 flex flex-col gap-2" style="color:var(--txt2);"><li><b>1 · Draft.</b> A new repo is analyzed against the whole catalog — summary, topics, and candidate typed edges with confidence scores.</li><li><b>2 · Review.</b> A human reads every proposed edge and its why. Weak edges are cut, wrong ones rejected, the note sharpened. Repos that don&#39;t earn a place are refused.</li><li><b>3 · Publish.</b> Only approved entries reach the catalog. The curator&#39;s take on each repo page includes when <em>not</em> to use a tool — that&#39;s the part no awesome-list will tell you.</li></ol><h2 class="mt-10 text-xl font-bold tracking-tight">And we do say no</h2><p class="mt-2" style="color:var(--txt2);"> Curation you can&#39;t see is curation you can&#39;t trust. Recent refusals, with the reason: </p><ul class="mt-3 flex flex-col gap-2" style="color:var(--txt2);"><!--[--><li><b class="mono">jev-trade</b> — Fork of jev-trader retargeted from Monad/Kuru to Hyperliquid at 26 stars, and the API reports no license despite an MIT badge — the original is mapped, the derivative has to stand on its own first. <span class="mono text-xs" style="color:var(--mut);">(maturity)</span></li><li><b class="mono">jev-social</b> — Typed Jev routing over Instagram/TikTok/LinkedIn research, 8 stars and days old — right scope for the map, too early to vouch for. <span class="mono text-xs" style="color:var(--mut);">(maturity)</span></li><li><b class="mono">jevlogs</b> — Scoring OpenTelemetry logs before expensive LLM analysis is a genuinely good use of a decision model, but its own badge says status:preview at 8 stars. <span class="mono text-xs" style="color:var(--mut);">(maturity)</span></li><li><b class="mono">jev-use</b> — The best demos of the Jev launch wave (decision latency as Pong ball speed) attached to a 5-star plugin — revisit when it grows. <span class="mono text-xs" style="color:var(--mut);">(maturity)</span></li><li><b class="mono">jev-for-chrome</b> — Chrome extension driving your own logged-in tab with Jev at 2 stars; the same ground is held by nanobrowser and jev-ultrafast. <span class="mono text-xs" style="color:var(--mut);">(maturity)</span></li><li><b class="mono">jevkit</b> — Tidy Rust CLI with offline question linting, but a 2-star single-API wrapper — nothing in the catalog can honestly pair with it yet. <span class="mono text-xs" style="color:var(--mut);">(maturity)</span></li><li><b class="mono">jev-pref</b> — Turning AGENTS.md preferences into a semantic linter is a real idea worth watching; 2 stars is too early for the map to vouch for it. <span class="mono text-xs" style="color:var(--mut);">(maturity)</span></li><li><b class="mono">jev-superpowers</b> — A superpowers fork with Jev bolted on at 1 star, SEO keyword frontmatter and a &#39;zero-hallucination&#39; claim the README doesn&#39;t evidence. <span class="mono text-xs" style="color:var(--mut);">(maturity)</span></li><li><b class="mono">PartMode</b> — Browser parametric CAD (OpenCascade WASM) with a genuinely good typed-agent permission model — but the core is mechanical design, no existing topic fits, and nothing in the catalog does CAD, so it lands with no honest edge. <span class="mono text-xs" style="color:var(--mut);">(scope)</span></li><li><b class="mono">avoid-slop</b> — A curated directory of anti-slop tools, not a tool — nothing can honestly pair with a link collection. <span class="mono text-xs" style="color:var(--mut);">(scope)</span></li><li><b class="mono">skills (alfonsograziano)</b> — Personal three-skill collection at 6 stars — the catalog vouches for what it maps; revisit if it grows. <span class="mono text-xs" style="color:var(--mut);">(maturity)</span></li><li><b class="mono">index</b> — Strong browser agent gone quiet — 14 months without a push, README pitching last year&#39;s models; the catalog vouches for what it maps. Revisit if it wakes. <span class="mono text-xs" style="color:var(--mut);">(maturity)</span></li><li><b class="mono">Auto-Deep-Research</b> — Ten months without a push and no license — two strikes; the catalog vouches for what it maps. Its parent AutoAgent framework may merit evaluation if it&#39;s still moving. <span class="mono text-xs" style="color:var(--mut);">(maturity)</span></li><li><b class="mono">blueprint-mcp</b> — A deployment recipe for Arcade&#39;s hosted MCP platform — sign-up, deploy and gateway required, no license. Vendor onboarding sample, not a self-contained tool. <span class="mono text-xs" style="color:var(--mut);">(scope)</span></li><li><b class="mono">pdf-mcp</b> — PDF MCP server at 52 stars — far below the bar, and the map&#39;s PDF tooling runs deep already. <span class="mono text-xs" style="color:var(--mut);">(maturity)</span></li><li><b class="mono">jobseek</b> — Career-page monitor at 163 stars — right neighborhood (would pair with ai-job-search), too early; revisit when it grows. <span class="mono text-xs" style="color:var(--mut);">(maturity)</span></li><li><b class="mono">multi-agent-generator</b> — Prompt-to-CrewAI/LangGraph code generator at 213 stars — thin surface today; revisit if it takes off. <span class="mono text-xs" style="color:var(--mut);">(maturity)</span></li><li><b class="mono">bmad-module-creative-intelligence-suite</b> — No license, 175 stars, and an add-on module for a method whose core isn&#39;t mapped — the catalog vouches for what it maps. <span class="mono text-xs" style="color:var(--mut);">(maturity)</span></li><li><b class="mono">deepseek_ocr_app</b> — Self-described &#39;quick vibe coded&#39; demo wrapper around DeepSeek-OCR — an end-user app, and the model class is already mapped (unlimited-ocr, chandra). <span class="mono text-xs" style="color:var(--mut);">(scope)</span></li><li><b class="mono">GeoLibre</b> — Cloud-native GIS platform — a superb tool with no AI/agent surface; no honest topic or edge in a map of AI-stack building blocks. <span class="mono text-xs" style="color:var(--mut);">(scope)</span></li><li><b class="mono">zero-employee-company-book</b> — A book about AI-run companies, not a tool you can put in a stack. <span class="mono text-xs" style="color:var(--mut);">(scope)</span></li><li><b class="mono">jobsync</b> — An end-user job-tracker app that uses AI — no honest topic in a map of AI-stack building blocks. <span class="mono text-xs" style="color:var(--mut);">(scope)</span></li><li><b class="mono">pake</b> — Webpage-to-desktop-app packager — a superb tool with zero AI/agent relevance; wrong map. <span class="mono text-xs" style="color:var(--mut);">(scope)</span></li><li><b class="mono">google-maps-agent-skills</b> — Right scope (agent skills), 121 stars and weeks quiet — revisit when it grows. <span class="mono text-xs" style="color:var(--mut);">(maturity)</span></li><li><b class="mono">seo-geo-claude-skills</b> — A signpost repo pointing at its own replacement, 85 stars — map the canonical home if it earns it. <span class="mono text-xs" style="color:var(--mut);">(maturity)</span></li><li><b class="mono">wigolo</b> — Right scope (local-first web MCP), public beta at 85 stars — revisit when it grows. <span class="mono text-xs" style="color:var(--mut);">(maturity)</span></li><li><b class="mono">awesome-harness-engineering</b> — An awesome-list, not a tool — nothing can honestly pair with a link collection. <span class="mono text-xs" style="color:var(--mut);">(scope)</span></li><li><b class="mono">FlashDB</b> — Embedded MCU database, not an embedding database — no honest topic or edge in an AI/agent catalog. <span class="mono text-xs" style="color:var(--mut);">(scope)</span></li><li><b class="mono">SwarnDB</b> — Interesting vector+graph idea at 13 stars with no license — the catalog vouches for what it maps. <span class="mono text-xs" style="color:var(--mut);">(maturity)</span></li><!--]--></ul><p class="mt-6" style="color:var(--txt2);"> The same gate applies to <b>connections</b>. Our discovery layer suggests semantically related pairs; a human promotes each one into a typed edge — or dismisses it. All <b style="color:var(--org);">99</b> dismissals are public. The most recent: </p><ul class="mt-3 flex flex-col gap-2" style="color:var(--txt2);"><!--[--><li><b class="mono">codenomad</b> <span style="color:var(--mut);">~</span> <b class="mono">alook</b> — retracted at the maintainers&#39; request (CodeNomad#619) — a cockpit for parallel OpenCode sessions vs a persistent multi-agent orchestration system are adjacent tools, not substitutes; the edge said &quot;same job&quot; and it wasn&#39;t <span class="mono text-xs" style="color:var(--mut);">(2026-09-03)</span></li><li><b class="mono">acontext</b> <span style="color:var(--mut);">~</span> <b class="mono">bemyagent</b> — adjacent vocabulary, different jobs — neither swappable nor demonstrably used together <span class="mono text-xs" style="color:var(--mut);">(2026-08-24)</span></li><li><b class="mono">acontext</b> <span style="color:var(--mut);">~</span> <b class="mono">squid</b> — adjacent vocabulary, different jobs — neither swappable nor demonstrably used together <span class="mono text-xs" style="color:var(--mut);">(2026-08-24)</span></li><li><b class="mono">adala</b> <span style="color:var(--mut);">~</span> <b class="mono">gigatoken</b> — adjacent vocabulary, different jobs — neither swappable nor demonstrably used together <span class="mono text-xs" style="color:var(--mut);">(2026-08-24)</span></li><li><b class="mono">adrian</b> <span style="color:var(--mut);">~</span> <b class="mono">plano</b> — adjacent vocabulary, different jobs — neither swappable nor demonstrably used together <span class="mono text-xs" style="color:var(--mut);">(2026-08-24)</span></li><li><b class="mono">adrian</b> <span style="color:var(--mut);">~</span> <b class="mono">agency-agents</b> — extractor hub artifact — &#39;Adrian&#39; as a concept node pulls in unrelated coding-agent repos; neither README mentions the other <span class="mono text-xs" style="color:var(--mut);">(2026-08-24)</span></li><li><b class="mono">adrian</b> <span style="color:var(--mut);">~</span> <b class="mono">jcode</b> — extractor hub artifact — &#39;Adrian&#39; as a concept node pulls in unrelated coding-agent repos; neither README mentions the other <span class="mono text-xs" style="color:var(--mut);">(2026-08-24)</span></li><li><b class="mono">adrian</b> <span style="color:var(--mut);">~</span> <b class="mono">maggy</b> — extractor hub artifact — &#39;Adrian&#39; as a concept node pulls in unrelated coding-agent repos; neither README mentions the other <span class="mono text-xs" style="color:var(--mut);">(2026-08-24)</span></li><!--]--></ul><h2 class="mt-10 text-xl font-bold tracking-tight">Kept honest, automatically</h2><p class="mt-2" style="color:var(--txt2);"> Stars, activity and imagery refresh twice a week straight from GitHub, so a card saying <span class="mono">updated yesterday</span> means yesterday. Know a repo that belongs on the map? <a href="/suggest" class="" style="color:var(--org);">Suggest it</a> — every submission goes through the same human review. </p><p class="mono mt-10 text-sm" style="color:var(--mut);"> Curious who&#39;s behind this? <a href="/about" class="" style="color:var(--org);">About StackMap &amp; ShipWithAI →</a></p></main><footer class="mt-16 px-6 py-10" style="border-top:1px solid var(--line);"><div class="mx-auto flex max-w-6xl flex-wrap items-start justify-between gap-8"><div class="max-w-sm"><div class="flex items-center gap-2"><span class="font-extrabold tracking-tight">Stack<span style="color:var(--org);">Map</span></span><span class="mono text-[.66rem] uppercase tracking-[.18em]" style="color:var(--mut);">by ShipWithAI</span></div><p class="mt-2 text-sm" style="color:var(--mut);"> The map of the AI stack. 421 repos, 1141 typed connections — every one human-reviewed, with the <em>why</em> written down. </p></div><nav class="flex flex-wrap gap-x-10 gap-y-6 text-sm" aria-label="Footer"><div class="flex flex-col gap-2"><span class="text-[.66rem] uppercase tracking-widest" style="color:var(--mut);">Site</span><a href="/" class="hover:text-white" style="color:var(--txt2);">Explore</a><a href="/changelog" class="hover:text-white" style="color:var(--txt2);">Changelog</a><a aria-current="page" href="/how-we-curate" class="router-link-active router-link-exact-active hover:text-white" style="color:var(--txt2);">How we curate</a><a href="https://stackmap.substack.com/archive" target="_blank" rel="noopener" class="hover:text-white" style="color:var(--txt2);">Digest archive</a></div><div class="flex flex-col gap-2"><span class="text-[.66rem] uppercase tracking-widest" style="color:var(--mut);">Connect</span><a href="/suggest" class="hover:text-white" style="color:var(--txt2);">Suggest a repo</a><a href="/feedback" class="hover:text-white" style="color:var(--txt2);">Feedback</a><a href="mailto:hello@shipwithai.xyz" class="hover:text-white" style="color:var(--txt2);">Contact</a></div><div class="flex flex-col gap-2"><span class="text-[.66rem] uppercase tracking-widest" style="color:var(--mut);">For agents</span><a href="/mcp" class="hover:text-white" style="color:var(--txt2);">MCP server</a><a href="/api/catalog.json" class="hover:text-white" style="color:var(--txt2);">JSON API</a><a href="/llms.txt" class="hover:text-white" style="color:var(--txt2);">llms.txt</a></div><form class="flex flex-col gap-2" aria-label="Newsletter"><span class="text-[.66rem] uppercase tracking-widest" style="color:var(--mut);">Weekly digest</span><input value="" type="email" name="email" required placeholder="you@work.dev" aria-label="Email address" class="w-44 rounded-lg px-2.5 py-1.5 text-sm outline-none" style="background:var(--surf);border:1px solid var(--line);color:var(--txt);"><button type="submit" class="btn self-start px-3 py-1.5 text-sm">Subscribe</button></form></nav></div><p class="mx-auto mt-8 max-w-6xl mono text-xs" style="color:var(--mut);"> © 2026 ShipWithAI · catalog data under the repos&#39; own licenses<!--[--> · map v2026.10.08<!--]--></p></footer></div></div><div id="teleports"></div><script>window.__NUXT__={};window.__NUXT__.config={public:{siteUrl:"https://stackmap.shipwithai.xyz",suggestUrl:"stackmap-suggest",newsletterUrl:"https://stackmap.substack.com",gtag:{enabled:true,initMode:"auto",id:"G-W1ME283DE4",initCommands:[],config:{},tags:[],loadingStrategy:"defer",url:"https://www.googletagmanager.com/gtag/js"}},app:{baseURL:"/",buildId:"0e7a65bd-2b4f-4132-8bd4-fa88e371888b",buildAssetsDir:"/_nuxt/",cdnURL:""}}</script><script type="application/json" data-nuxt-data="nuxt-app" data-ssr="true" id="__NUXT_DATA__" data-src="/how-we-curate/_payload.json?_b=0e7a65bd-2b4f-4132-8bd4-fa88e371888b">[{"state":1,"once":3,"_errors":4,"serverRendered":6,"path":7,"prerenderedAt":8},["Reactive",2],{},["Set"],["ShallowReactive",5],{},true,"\u002Fhow-we-curate",1791466615997]</script></body></html>